<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DotNetGrpcGateway</RootNamespace>
    <AssemblyName>DotNetGrpcGateway</AssemblyName>
    <IsPackable>true</IsPackable>
    <Version>1.0.0</Version>
    <Authors>Vladyslav Zaiets</Authors>
    <Description>Gateway for ASP.NET Core that exposes backend gRPC services to browsers over gRPC-Web without Envoy, adding service discovery, load balancing, circuit breakers, metrics and request logging.</Description>
    <PackageId>Zaiets.dotnet.grpc.gateway</PackageId>
    <PackageTags>grpc gateway http-json transcoding load-balancing service-discovery</PackageTags>
    <PackageProjectUrl>https://github.com/sarmkadan/dotnet-grpc-gateway</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sarmkadan/dotnet-grpc-gateway</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: public members lack XML doc comments (about 530 of them); documenting them all is a separate docs task. -->
    <!-- NU1510: pruning hints for three packages; the dependency list needs its own audit before removing anything. -->
    <!-- NU1603: pinned 2.68.0 versions are not on the configured feed, so NuGet resolves 2.70.0 instead. -->
    <NoWarn>$(NoWarn);CS1591;NU1510;NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.68.0" />
    <PackageReference Include="Grpc.AspNetCore.Web" Version="2.68.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.68.0" />
    <PackageReference Include="protobuf-net.Grpc.AspNetCore" Version="1.1.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <PackageReference Include="Dapper" Version="2.1.15" />
    <PackageReference Include="FluentValidation" Version="11.9.2" />
    <PackageReference Include="System.Threading.RateLimiting" Version="10.0.0" />
  </ItemGroup>

</Project>
