<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- NU1603: pinned package versions are not on the configured feed, so NuGet resolves newer patches instead. -->
    <!-- CS8600/CS8604/CS8625/CS8629: tests pass null on purpose to exercise argument guards and null-handling paths. -->
    <!-- CS8620: Moq/ILogger formatter delegates use a non-nullable Exception parameter that doesn't match Microsoft.Extensions.Logging's Exception?. -->
    <NoWarn>$(NoWarn);NU1603;CS8600;CS8604;CS8620;CS8625;CS8629</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\dotnet-grpc-gateway\dotnet-grpc-gateway.csproj" />
  </ItemGroup>

</Project>
