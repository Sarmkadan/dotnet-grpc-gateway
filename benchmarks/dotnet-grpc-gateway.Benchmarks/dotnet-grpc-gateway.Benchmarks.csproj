<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- NU1603: pinned package versions are not on the configured feed, so NuGet resolves newer patches instead. -->
    <!-- CS8618: benchmark fields are assigned in [GlobalSetup] methods, which the compiler's constructor analysis cannot see. -->
    <NoWarn>$(NoWarn);NU1603;CS8618</NoWarn>
</PropertyGroup>

<ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.19" />
    <PackageReference Include="Grpc.AspNetCore.Web" Version="2.68.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.68.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="protobuf-net.Grpc.AspNetCore" Version="1.1.1" />
</ItemGroup>

<ItemGroup>
    <ProjectReference Include="../../src/dotnet-grpc-gateway/dotnet-grpc-gateway.csproj" />
</ItemGroup>

</Project>
